// Pengaturan Cloudflare Workers untuk Nāṭiq.
// "name" harus sama dengan nama Worker di dashboard Cloudflare.
{
  "name": "naatiqiubs",
  "main": "server/worker.ts",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  }
}
